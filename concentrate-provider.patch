+/** The vendor mark for a model id, or "" when no known vendor makes it. A routed id
+ *  ("moonshotai/kimi-k2") is matched on its last segment. */
+export function modelMark(modelId: string, size: number): string {
+  const name = modelId.split("/").pop() ?? modelId;
+  const rule = MODEL_MARK_RULES.find(([pattern]) => pattern.test(name));
+  return rule === undefined ? "" : rule[1].split("{S}").join(String(size));
